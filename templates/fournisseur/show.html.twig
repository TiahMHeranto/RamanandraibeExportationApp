{% extends 'layout.html.twig' %}

{% block title %}{{ fournisseur.nom }} — Ramanandraibe Exportation{% endblock %}
{% block page_title %}{{ fournisseur.code }}{% endblock %}
{% block page_actions %}
    <a class="btn btn-ghost" href="{{ path('app_arrivage_new') }}">Nouvel arrivage</a>
    <a class="btn btn-ghost" href="{{ path('app_fournisseur_edit', {id: fournisseur.id}) }}">Modifier</a>
{% endblock %}

{% block content %}
<section class="detail-grid">
    <article class="panel">
        <h2>{{ fournisseur.nom }}</h2>
        <dl class="meta">
            <div>
                <dt>Code fournisseur</dt>
                <dd>{{ fournisseur.code }}</dd>
            </div>
            <div>
                <dt>Zone</dt>
                <dd>{{ fournisseur.zone }}</dd>
            </div>
            <div>
                <dt>Statut</dt>
                <dd>{{ fournisseur.actif ? 'Actif' : 'Inactif' }}</dd>
            </div>
            <div>
                <dt>Mis à jour</dt>
                <dd>{{ fournisseur.updatedAt|date('d/m/Y H:i') }}</dd>
            </div>
        </dl>
        <form method="post" action="{{ path('app_fournisseur_delete', {id: fournisseur.id}) }}" onsubmit="return confirm('Supprimer ce fournisseur ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ fournisseur.id) }}">
            <button class="btn btn-danger" type="submit">Supprimer</button>
        </form>
    </article>
    <article class="panel">
        <div class="panel-head">
            <h2>Arrivages</h2>
        </div>
        {% if fournisseur.arrivages is empty %}
            <p class="empty">Aucun arrivage lié.</p>
        {% else %}
            <ul class="simple-list">
                {% for arrivage in fournisseur.arrivages %}
                    <li>
                        <a href="{{ path('app_arrivage_show', {id: arrivage.id}) }}">{{ arrivage.numero }}</a>
                        <span>{{ arrivage.poids }} kg — {{ arrivage.dateArrivage|date('d/m/Y') }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </article>
</section>
{% endblock %}
