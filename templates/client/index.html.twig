{% extends 'layout.html.twig' %}

{% block title %}Clients — Ramanandraibe Exportation{% endblock %}
{% block page_title %}Clients{% endblock %}
{% block page_actions %}
    <a class="btn btn-primary" href="{{ path('app_client_new') }}">Add client</a>
{% endblock %}

{% block content %}
<section class="panel">
    {% if clients is empty %}
        <p class="empty">No buyers registered yet.</p>
    {% else %}
        <table class="table">
            <thead>
            <tr>
                <th>Company</th>
                <th>Contact</th>
                <th>Country</th>
                <th>Email</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for client in clients %}
                <tr>
                    <td><a href="{{ path('app_client_show', {id: client.id}) }}">{{ client.companyName }}</a></td>
                    <td>{{ client.contactName }}</td>
                    <td>{{ client.city ? client.city ~ ', ' : '' }}{{ client.country }}</td>
                    <td>{{ client.email }}</td>
                    <td class="actions">
                        <a href="{{ path('app_client_edit', {id: client.id}) }}">Edit</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>
{% endblock %}
