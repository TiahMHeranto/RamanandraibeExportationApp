{% extends 'layout.html.twig' %}

{% block title %}{{ title }} — Ramanandraibe Exportation{% endblock %}
{% block page_title %}{{ title }}{% endblock %}

{% block content %}
<section class="panel form-panel">
    {{ form_start(form) }}
        <div class="form-grid">
            {{ form_row(form.companyName) }}
            {{ form_row(form.contactName) }}
            {{ form_row(form.email) }}
            {{ form_row(form.phone) }}
            {{ form_row(form.country) }}
            {{ form_row(form.city) }}
            <div class="span-2">{{ form_row(form.address) }}</div>
        </div>
        <div class="form-actions">
            <a class="btn btn-ghost" href="{{ path('app_client_index') }}">Cancel</a>
            <button class="btn btn-primary" type="submit">Save client</button>
        </div>
    {{ form_end(form) }}
</section>
{% endblock %}
