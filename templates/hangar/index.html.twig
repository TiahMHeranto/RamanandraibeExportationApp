{% extends 'layout.html.twig' %}

{% block body_class %}{{ parent() }} page-viewport page-hangars{% endblock %}

{% block title %}Hangars — Ramanandraibe Exportation{% endblock %}
{% block page_title %}Hangars de traitement{% endblock %}
{% block page_actions %}
    <a class="btn btn-ghost" href="{{ path('app_hangar_export_pdf', q ? {q: q} : {}) }}">Exporter PDF</a>
    <a class="btn btn-primary" href="{{ path('app_hangar_new') }}">Ajouter</a>
{% endblock %}

{% block content %}
<section class="panel panel-fill">
    <div class="panel-head">
        <h2>
            {% if total == 0 %}
                0 hangar
            {% else %}
                {{ pagination.from }}–{{ pagination.to }} / {{ total }} hangar{{ total > 1 ? 's' : '' }}
            {% endif %}
        </h2>
        <form method="get" class="search-form" action="{{ path('app_hangar_index') }}">
            <input type="search" name="q" value="{{ q }}" placeholder="Rechercher n° ou code…">
            <button class="btn btn-ghost" type="submit">Filtrer</button>
            {% if q %}
                <a class="btn btn-ghost" href="{{ path('app_hangar_index') }}">Réinitialiser</a>
            {% endif %}
        </form>
    </div>

    {% if hangars is empty %}
        <p class="empty">Aucun hangar. Ajoutez-en un ou importez via <code>php bin/console app:import-hangars</code>.</p>
    {% else %}
        <div class="table-scroll">
            <table class="table table-sticky">
                <thead>
                <tr>
                    <th>Hangar numéro</th>
                    <th>Code</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for hangar in hangars %}
                    <tr>
                        <td><a href="{{ path('app_hangar_show', {id: hangar.id}) }}"><strong>{{ hangar.numero }}</strong></a></td>
                        <td>{{ hangar.code }}</td>
                        <td>
                            {% if hangar.actif %}
                                <span class="badge badge-delivered">Actif</span>
                            {% else %}
                                <span class="badge badge-cancelled">Inactif</span>
                            {% endif %}
                        </td>
                        <td class="actions">
                            <a href="{{ path('app_hangar_edit', {id: hangar.id}) }}">Modifier</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.pages > 1 %}
            <nav class="pagination" aria-label="Pagination hangars">
                {% set queryParams = q ? {q: q} : {} %}
                <a
                    class="btn btn-ghost {{ pagination.page <= 1 ? 'is-disabled' : '' }}"
                    href="{{ pagination.page <= 1 ? '#' : path('app_hangar_index', queryParams|merge({page: pagination.page - 1})) }}"
                >Précédent</a>
                <div class="pagination-pages">
                    {% for p in 1..pagination.pages %}
                        {% if p == pagination.page %}
                            <span class="page-chip is-current" aria-current="page">{{ p }}</span>
                        {% elseif p == 1 or p == pagination.pages or (p >= pagination.page - 2 and p <= pagination.page + 2) %}
                            <a class="page-chip" href="{{ path('app_hangar_index', queryParams|merge({page: p})) }}">{{ p }}</a>
                        {% elseif p == pagination.page - 3 or p == pagination.page + 3 %}
                            <span class="page-ellipsis">…</span>
                        {% endif %}
                    {% endfor %}
                </div>
                <a
                    class="btn btn-ghost {{ pagination.page >= pagination.pages ? 'is-disabled' : '' }}"
                    href="{{ pagination.page >= pagination.pages ? '#' : path('app_hangar_index', queryParams|merge({page: pagination.page + 1})) }}"
                >Suivant</a>
            </nav>
        {% endif %}
    {% endif %}
</section>
{% endblock %}
