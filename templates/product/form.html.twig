{% extends 'layout.html.twig' %}

{% block title %}{{ title }} — Ramanandraibe Exportation{% endblock %}
{% block page_title %}{{ title }}{% endblock %}

{% block content %}
<section class="panel form-panel">
    {{ form_start(form) }}
        <div class="form-grid">
            {{ form_row(form.name) }}
            {{ form_row(form.sku) }}
            {{ form_row(form.category) }}
            {{ form_row(form.unit) }}
            {{ form_row(form.unitPrice) }}
            {{ form_row(form.active) }}
            <div class="span-2">{{ form_row(form.description) }}</div>
        </div>
        <div class="form-actions">
            <a class="btn btn-ghost" href="{{ path('app_product_index') }}">Cancel</a>
            <button class="btn btn-primary" type="submit">Save product</button>
        </div>
    {{ form_end(form) }}
</section>
{% endblock %}
