{% extends 'base.html.twig' %}

{% block body_class %}app-shell{% endblock %}

{% block body %}
<div class="app">
    <aside class="sidebar">
        <a class="brand" href="{{ path('app_dashboard') }}">
            <span class="brand-mark">RE</span>
            <span class="brand-text">
                <strong>Ramanandraibe</strong>
                <small>Exportation</small>
            </span>
        </a>
        <nav class="nav">
            <a href="{{ path('app_dashboard') }}" class="{{ app.request.attributes.get('_route') == 'app_dashboard' ? 'is-active' : '' }}">Overview</a>
            <a href="{{ path('app_personnel_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_personnel' ? 'is-active' : '' }}">Personnels</a>
            <a href="{{ path('app_fournisseur_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_fournisseur' ? 'is-active' : '' }}">Fournisseurs</a>
            <a href="{{ path('app_shipment_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_shipment' ? 'is-active' : '' }}">Shipments</a>
            <a href="{{ path('app_client_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_client' ? 'is-active' : '' }}">Clients</a>
            <a href="{{ path('app_product_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_product' ? 'is-active' : '' }}">Products</a>
        </nav>
        <div class="sidebar-foot">
            <div class="user-chip">
                <span>{{ app.user.fullName }}</span>
                <small>{{ app.user.userIdentifier }}</small>
            </div>
            <a class="btn btn-ghost" href="{{ path('app_logout') }}">Sign out</a>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div>
                <p class="eyebrow">Operations desk</p>
                <h1>{% block page_title %}Dashboard{% endblock %}</h1>
            </div>
            {% block page_actions %}{% endblock %}
        </header>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="content">
            {% block content %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}
